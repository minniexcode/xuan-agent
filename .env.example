# 玄枢本地配置。复制为 .env 后填写。API key 不会被打印或写入日志。

# Provider（V1 仅 openai-compatible）
XUAN_PROVIDER=openai-compatible

# 具体模型名（DeepSeek 走 openai-compatible）
XUAN_MODEL=deepseek-chat

# API key
XUAN_API_KEY=

# Base URL
XUAN_BASE_URL=https://api.deepseek.com/v1

# 基础参数
XUAN_TEMPERATURE=0.4
# 推理模型思考会吃大量 token，解读默认给足额度
XUAN_MAX_TOKENS=16000
XUAN_ENABLE_VISION=false
XUAN_ENABLE_STREAMING=true

# 本地路径（留空则用平台默认）
XUAN_PROFILE_DIR=
XUAN_KNOWLEDGE_DIR=
XUAN_LOG_LEVEL=info
